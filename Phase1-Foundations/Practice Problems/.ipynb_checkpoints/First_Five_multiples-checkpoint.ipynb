   "source": [
    "# Write a program to input a number and print its first five multiples"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c9cb99f5-a262-4164-b7b3-545aef4a3d9e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number:  3\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "3 x 1 = 3 \n",
      "3 x 2 = 6\n",
      "3 x 3 = 9\n",
      "3 x 4 = 12\n",
      "3 x 5 = 15\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "print(f'''\n",
    "{n} x {1} = {n * 1} \n",
    "{n} x {2} = {n * 2}\n",
    "{n} x {3} = {n * 3}\n",
    "{n} x {4} = {n * 4}\n",
    "{n} x {5} = {n * 5}''')"
   ]
  }
 ],
