   "source": [
    "# Write a program to calculate compound interest."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "1d1f59b0-237c-4c27-9474-c1123b5ec050",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Compound Interest: 79439.36\n"
     ]
    }
   ],
   "source": [
    "principle_amount = 40000\n",
    "rate = 20\n",
    "time = 6\n",
    "\n",
    "amount = principle_amount * (1 + (rate/100))**time\n",
    "compound_interest = amount - principle_amount\n",
    "\n",
    "print(f'Compound Interest: {compound_interest:.2f}')"
   ]
  }
 ],
